# Copy to .env.local for local development. Never commit real secrets.

# Canonical site URL. Leave empty locally and on Vercel previews
# (Vercel's own preview URL is used automatically).
# Set it only when this site becomes the production site.
NEXT_PUBLIC_SITE_URL=

# Search engines are blocked by default so this redesign does not compete with
# the live site at odysseyventures.llc. Set to "true" only at launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Supabase: NOT used yet. Uncomment when a database is added.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
